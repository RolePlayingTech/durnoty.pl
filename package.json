{
  "name": "durnoty.pl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "media": "tsx scripts/create-media.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "astro": "^7.3.3",
    "better-sqlite3": "^13.0.3",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
